---
// Verified track-record figures from R&R's 2025 credentials deck.
const stats = [
  { value: '25+', label: 'Years in business' },
  { value: '2,000+', label: 'Projects managed' },
  { value: '150+', label: 'Brands served' },
  { value: '100,000', label: 'Media coverage clips' },
  { value: '40,000+', label: 'Influencer & reviewer posts' },
  { value: '10+', label: 'Industry awards' },
];
---

<dl class="stats">
  {
    stats.map((s) => (
      <div class="stats__item">
        <dd>{s.value}</dd>
        <dt>{s.label}</dt>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
    margin: 0;
  }

  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
  }

  .stats__item dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 500;
    color: var(--teal);
    line-height: 1.1;
  }

  .stats__item dt {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
  }
</style>
