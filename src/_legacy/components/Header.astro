---
import Logo from './Logo.astro';

const nav = [
  { href: '/about', label: 'Our Story' },
  { href: '/services', label: 'Expertise' },
  { href: '/case-studies', label: 'Purpose in Action' },
  { href: '/team', label: 'Our People' },
  { href: '/insights', label: 'Perspectives' },
  { href: '/careers', label: 'Join the Team' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="R&R Communications — home">
      <Logo />
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle-input" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle" aria-hidden="true">
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="visually-hidden">Menu</span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="site-nav__cta">
          <a href="/contact" class="btn btn--primary">Start a Conversation</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<!-- Floating WhatsApp click-to-chat, reachable from every page -->
<a
  href="https://wa.me/628179206683"
  class="wa-float"
  target="_blank"
  rel="noopener"
  aria-label="Chat with R&R Communications on WhatsApp"
>
  <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor" aria-hidden="true">
    <path
      d="M12 2a9.94 9.94 0 0 0-8.59 15.03L2 22l5.13-1.35A9.96 9.96 0 1 0 12 2Zm0 18.13c-1.6 0-3.16-.43-4.53-1.24l-.32-.19-3.04.8.81-2.97-.21-.3a8.12 8.12 0 1 1 7.29 3.9Zm4.46-6.08c-.24-.12-1.44-.71-1.66-.79-.22-.08-.39-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.53.06-.24-.12-1.03-.38-1.96-1.21-.72-.64-1.21-1.44-1.35-1.68-.14-.24-.02-.37.11-.5.11-.11.24-.28.37-.42.12-.14.16-.24.24-.41.08-.16.04-.3-.02-.42-.06-.12-.55-1.32-.75-1.81-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.65.3-.22.24-.85.83-.85 2.02s.87 2.35 1 2.51c.12.16 1.71 2.61 4.15 3.66.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.46-.28Z"
    />
  </svg>
</a>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.875rem;
  }

  .site-header__logo {
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav a:not(.btn) {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  .site-nav a:not(.btn):hover {
    color: var(--teal-dark);
  }

  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--teal);
    color: var(--navy);
  }

  .site-nav__cta .btn {
    padding: 0.625rem 1.25rem;
  }

  .nav-toggle,
  .nav-toggle-input {
    display: none;
  }

  @media (max-width: 980px) {
    .nav-toggle {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 0.5rem;
      cursor: pointer;
    }

    .nav-toggle__bar {
      width: 24px;
      height: 2px;
      background: var(--navy);
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--cream);
      border-bottom: 1px solid var(--line);
      display: none;
      padding: 1rem 1.5rem 1.5rem;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .nav-toggle-input:checked ~ .site-nav {
      display: block;
    }

    .nav-toggle-input:checked ~ .nav-toggle .nav-toggle__bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle-input:checked ~ .nav-toggle .nav-toggle__bar:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle-input:checked ~ .nav-toggle .nav-toggle__bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }

  .wa-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--teal-dark);
    color: var(--white);
    box-shadow: 0 6px 18px rgba(30, 61, 80, 0.28);
    transition: background-color 0.2s ease;
  }

  .wa-float:hover {
    background: var(--navy);
    color: var(--white);
  }
</style>
