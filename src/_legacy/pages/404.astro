---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page Not Found — R&R Communications"
  description="The page you were looking for could not be found."
  path="/404"
>
  <section class="section" style="min-height: 50vh;">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>That page has moved on</h1>
      <p class="lede">
        The page you were looking for does not exist — perhaps it changed with the
        2025 rebrand. The links below will get you back on track.
      </p>
      <div class="btn-row">
        <a href="/" class="btn btn--primary">Back to Home</a>
        <a href="/contact" class="btn btn--ghost">Start a Conversation</a>
      </div>
    </div>
  </section>
</Base>
