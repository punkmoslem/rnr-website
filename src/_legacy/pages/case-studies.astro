---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { caseStudies } from '../data/caseStudies';
---

<Base
  title="Purpose in Action — PR Case Studies | R&R Communications"
  description="Real client results: MSD Indonesia, Bayer, JEC Eye Hospitals, Samsung, SKF and Bosch — with the media coverage, campaigns and outcomes behind each partnership."
  path="/case-studies"
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">Purpose in Action</span>
      <h1>The work, and what it delivered</h1>
      <p class="lede">
        Reputation is built in the doing. These are selected engagements from
        twenty-six years of client work — each with the challenge we were handed,
        the approach we took, and the results we can put a number on.
      </p>
    </div>
  </section>

  <section class="section section--alt section--tight">
    <div class="container">
      <div class="cs-grid" data-reveal-stagger>
        {
          caseStudies.map((cs) => (
            <article class="cs-card" id={cs.slug}>
              <header>
                <p class="cs-card__meta">
                  <span class="cs-card__sector">{cs.sector}</span>
                  <span class="cs-card__period">{cs.period}</span>
                </p>
                <p class="cs-card__client">{cs.client}</p>
                <h2>{cs.title}</h2>
              </header>

              <dl class="cs-card__body">
                <dt>Challenge</dt>
                <dd>{cs.challenge}</dd>
                <dt>Approach</dt>
                <dd>{cs.approach}</dd>
                <dt>Result</dt>
                <dd>{cs.result}</dd>
              </dl>

              <ul class="cs-card__metrics" role="list">
                {cs.metrics.map((m) => (
                  <li>
                    <span class="cs-card__metric-value">{m.value}</span>
                    <span class="cs-card__metric-label">{m.label}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <p class="cs-note">
        Figures are drawn from R&R's verified client records. Additional case studies
        — including product-launch repositioning, multi-stakeholder health forums and
        B2B technology campaigns — are available on request.
      </p>
    </div>
  </section>

  <CtaBand
    heading="Your brand could be the next case study"
    body="Bring us the challenge. We will bring the approach — and commit to results we can measure."
  />
</Base>

<style>
  .cs-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .cs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cs-card {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .cs-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--teal) 45%, var(--line));
    box-shadow: 0 18px 40px -18px rgba(30, 61, 80, 0.25);
  }

  .cs-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8125rem;
    margin-bottom: 1rem;
  }

  .cs-card__sector {
    background: var(--cream-dark);
    color: var(--navy);
    font-weight: 600;
    border-radius: 999px;
    padding: 0.25rem 0.875rem;
  }

  .cs-card__period {
    color: var(--muted);
    padding-block: 0.25rem;
  }

  .cs-card__client {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-dark);
    margin-bottom: 0.5rem;
  }

  .cs-card h2 {
    font-size: 1.5rem;
  }

  .cs-card__body {
    margin: 0;
    display: grid;
    gap: 0.375rem;
  }

  .cs-card__body dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 1rem;
  }

  .cs-card__body dt:first-child {
    margin-top: 0;
  }

  .cs-card__body dd {
    margin: 0;
    font-size: 0.9875rem;
  }

  .cs-card__metrics {
    display: flex;
    gap: 2.5rem;
    list-style: none;
    padding: 1.5rem 0 0;
    margin: auto 0 0;
    border-top: 1px solid var(--line);
  }

  .cs-card__metrics li {
    display: flex;
    flex-direction: column;
  }

  .cs-card__metric-value {
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--teal-dark);
    line-height: 1.1;
  }

  .cs-card__metric-label {
    font-size: 0.8125rem;
    color: var(--muted);
    margin-top: 0.25rem;
  }

  .cs-note {
    margin-top: 2.5rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
