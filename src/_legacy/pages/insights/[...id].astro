---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('insights');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  title={`${post.data.title} — Perspectives | R&R Communications`}
  description={post.data.description}
  path={`/insights/${post.id}`}
>
  <article class="section">
    <div class="container article">
      <p class="article__meta">
        <a href="/insights">← All Perspectives</a>
      </p>
      <h1>{post.data.title}</h1>
      <p class="article__byline">
        {post.data.author} ·
        <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
      </p>
      <div class="article__body">
        <Content />
      </div>
      <footer class="article__footer">
        <p>
          Talking through a communications challenge is what we do.
          <a href="/contact">Start a conversation</a> with the team.
        </p>
      </footer>
    </div>
  </article>
</Base>

<style>
  .article {
    max-width: 46rem;
  }

  .article__meta {
    font-size: 0.875rem;
    margin-bottom: 2rem;
  }

  .article__byline {
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  .article__body {
    margin-top: 2.5rem;
  }

  .article__body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
  }

  .article__body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .article__body :global(p) {
    margin-block: 1rem;
  }

  .article__body :global(ul),
  .article__body :global(ol) {
    padding-left: 1.5rem;
    margin-block: 1rem;
    display: grid;
    gap: 0.375rem;
  }

  .article__body :global(blockquote) {
    border-left: 3px solid var(--teal);
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1.25rem;
    color: var(--muted);
    font-style: italic;
  }

  .article__footer {
    margin-top: 3rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
</style>
