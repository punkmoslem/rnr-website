---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path portion of the canonical URL, e.g. "/about" */
  path?: string;
  ogImage?: string;
}

const { title, description, path = '/', ogImage = '/og-image.jpg' } = Astro.props;
const site = 'https://rikadanrekan.id';
const canonical = new URL(path, site).href;
const ogImageUrl = new URL(ogImage, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="R&R Communications" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=Montserrat:wght@700&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        name: 'R&R Communications',
        legalName: 'PT Komunika Pratama Reksa',
        description:
          'Jakarta-based public relations and communications consultancy serving corporate clients across Indonesia since 2000.',
        url: site,
        telephone: '+62-21-726-3109',
        foundingDate: '2000',
        slogan: 'Communication with Purpose',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Jl. Bungur No. 88, Kebayoran Lama',
          addressLocality: 'Jakarta Selatan',
          addressRegion: 'DKI Jakarta',
          addressCountry: 'ID',
        },
        areaServed: 'Indonesia',
      })}
    />
  </head>
  <body>
    <script is:inline>
      // Flag JS availability before paint so reveal styles only apply
      // when the observer below can undo them.
      document.documentElement.classList.add('js');
    </script>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Quiet fade-and-rise on scroll; elements above the fold reveal
      // immediately. prefers-reduced-motion is handled in CSS.
      const pending = new Set(
        document.querySelectorAll('[data-reveal], [data-reveal-stagger]')
      );

      const show = (el: Element) => {
        el.classList.add('is-visible');
        pending.delete(el);
        observer.unobserve(el);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) show(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      pending.forEach((t) => observer.observe(t));

      // Fallback for environments where IntersectionObserver callbacks are
      // throttled (embedded webviews, energy-saver tabs): reveal anything
      // already within the viewport on scroll/resize.
      let ticking = false;
      const sweep = () => {
        ticking = false;
        for (const el of [...pending]) {
          const r = el.getBoundingClientRect();
          if (r.top < window.innerHeight * 0.95 && r.bottom > 0) show(el);
        }
        if (pending.size === 0) {
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        }
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(sweep);
          setTimeout(sweep, 120); // rAF may also be throttled
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
    </script>
  </body>
</html>
