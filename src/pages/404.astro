---
import Base from '../layouts/Base.astro';
---
<Base title="Lost & Found — R&R Communications" description="Page not found." gate={false}>
  <section class="hero">
    <span class="ghostamp" aria-hidden="true">&amp;</span>
    <div class="wrap intro" style="padding-bottom:96px">
      <span class="kicker">Lost &amp; Found</span>
      <h1>This page isn't<br />part of the story.</h1>
      <p class="lede">The link may be old, or the address mistyped. The connection you want is one click away.</p>
      <div class="cta-row">
        <a class="btn" href="/">Back to the start <span class="arr">→</span></a>
        <a class="btn ghost" href="/you-and-us">Talk to us instead</a>
      </div>
    </div>
  </section>
</Base>
